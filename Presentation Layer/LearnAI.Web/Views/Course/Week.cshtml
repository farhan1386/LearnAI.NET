@model LearnAI.Web.Models.WeekData
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="mb-5">
        <a href="@Url.Action("Index", "Course")" class="btn btn-link text-secondary text-decoration-none p-0 mb-3 d-inline-flex align-items-center gap-2 transition-smooth hover-translate-x">
            <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
            </svg>
            Back to Curriculum
        </a>
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <div class="text-uppercase tracking-wider text-primary fw-bold small mb-1">Module @ViewBag.WeekNumber.ToString("D2")</div>
                <h1 class="h2 fw-extrabold text-dark m-0">@Model.Title Checklist</h1>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="accordion accordion-flush" id="checklistAccordion-W@ViewBag.WeekNumber">
                @{
                    int dayCounter = 0;
                }
                @foreach (var day in Model.Days)
                {
                    dayCounter++;
                    string collapseId = $"collapse-W{ViewBag.WeekNumber}-day{dayCounter}";
                    string showClass = dayCounter == 1 ? "show" : "";
                    string buttonClass = dayCounter == 1 ? "" : "collapsed";

                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden day-accordion-group bg-white">
                        <h3 class="accordion-header">
                            <button class="accordion-button bg-white text-dark fw-bold px-4 py-3-5 @buttonClass" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge rounded-pill bg-light text-primary border border-primary-subtle px-3 py-2 fw-semibold">@day.DayNum</span>
                                        <span class="text-dark-emphasis fw-bold text-truncate design-title-sync">@day.DayTitle</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-3 ms-auto" style="min-width: 140px;">
                                        <div class="progress flex-grow-1" style="height: 6px; background-color: #f1f3f5; border-radius: 10px;">
                                            <div class="progress-bar bg-success day-mini-progress rounded-pill" role="progressbar" style="width: 0%"></div>
                                        </div>
                                        <span class="fw-bold text-secondary day-progress-text" style="font-size: 0.85rem; width: 35px; text-align: right;">0%</span>
                                    </div>
                                </div>
                            </button>
                        </h3>

                        <div id="@collapseId" class="accordion-collapse collapse @showClass" data-bs-parent="#checklistAccordion-W@ViewBag.WeekNumber">
                            <div class="accordion-body border-top border-light-subtle bg-white px-4 py-4">
                                @foreach (var sec in day.Sections)
                                {
                                    string headingClass = $"{sec.TextColor} fw-bold small text-uppercase tracking-wider d-flex align-items-center gap-2 mb-3";
                                    <div class="mb-4 last-mb-0">
                                        <div class="@headingClass">
                                            <span>@sec.Icon</span>
                                            <span>@sec.Title</span>
                                        </div>

                                        <div class="d-flex flex-column gap-2-5 ps-1">
                                            @foreach (var item in sec.Items)
                                            {
                                                string uniqueStorageKey = $"W{ViewBag.WeekNumber}-{day.DayNum}-{sec.Title}-{item.Label}"
                                                    .Replace(" ", "").Replace("?", "").Replace("!", "").Replace(".", "").Replace(":", "").Replace("→", "");

                                                <div class="form-check custom-checklist-row d-flex align-items-start p-3 rounded-3 border transition-smooth">
                                                    @if (!string.IsNullOrEmpty(item.Answer))
                                                    {
                                                        <input class="form-check-input chk-box mt-0-5 me-3 flex-shrink-0" type="checkbox" id="@uniqueStorageKey" data-storage-key="@uniqueStorageKey" disabled>
                                                        <a href="#" class="text-dark text-decoration-none fw-medium flex-grow-1 curriculum-popup-link d-flex align-items-center justify-content-between gap-2" data-title="@item.Label" data-answer="@item.Answer">
                                                            <span>@item.Label</span>
                                                            <span class="badge bg-light text-primary border border-light-subtle rounded-pill font-xsmall px-2 py-1 flex-shrink-0">Read</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <input class="form-check-input chk-box mt-0-5 me-3 flex-shrink-0" type="checkbox" id="@uniqueStorageKey" data-storage-key="@uniqueStorageKey">
                                                        <label class="form-check-label text-dark fw-medium flex-grow-1 cursor-pointer" for="@uniqueStorageKey">
                                                            @item.Label
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top overflow-hidden" style="top: 2rem; background: #fafbfc; border: 1px solid rgba(0,0,0,0.03) !important;">
                <div class="card-body p-4">
                    <h3 class="h6 fw-bold text-uppercase tracking-wider text-secondary mb-3">Overall Progress</h3>

                    <div class="d-flex align-items-baseline gap-2 mb-3">
                        <span id="moduleProgressPercentText" class="display-5 fw-extrabold text-dark tracking-tight">0%</span>
                        <span class="text-muted fw-medium small">completed</span>
                    </div>

                    <div class="progress mb-4" style="height: 12px; background-color: #e9ecef; border-radius: 10px;">
                        <div id="moduleProgressBar" class="progress-bar bg-success rounded-pill transition-smooth" role="progressbar" style="width: 0%"></div>
                    </div>

                    <div class="d-flex align-items-start gap-2 text-muted mb-4 p-3 rounded-3 bg-white border border-light-subtle">
                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-info-circle text-primary mt-0-5 flex-shrink-0" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                        </svg>
                        <p class="small m-0 lh-base">Your choices are synced continuously with your local browser storage history.</p>
                    </div>

                    <button class="btn btn-link text-danger text-decoration-none fw-semibold w-100 py-2 border border-danger-subtle rounded-3 bg-white btn-hover-danger transition-smooth" type="button" onclick="resetChecklist()">
                        Reset Progress Records
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="curriculumModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg rounded-4 border-0">
            <div class="modal-header border-bottom border-light-subtle px-4 py-3">
                <h5 class="modal-title fw-bold text-dark" id="modalQuestionTitle">Question Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 fs-6 lh-base text-dark-emphasis" id="modalAnswerBody">
                Answer content goes here.
            </div>
            <div class="modal-footer border-top border-light-subtle px-4 py-2">
                <button type="button" class="btn btn-light border px-4 rounded-3 fw-semibold small" data-bs-dismiss="modal">Dismiss</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/curriculum.js" asp-append-version="true"></script>
}
