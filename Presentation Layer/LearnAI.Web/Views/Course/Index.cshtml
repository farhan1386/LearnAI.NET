@{
    ViewData["Title"] = "Course";

    var modules = new Dictionary<int, (string Title, string BadgeClass, string TextClass, string BarClass, string[] Days)>
    {
        { 1, ("Chat", "bg-primary", "text-primary", "bg-primary", new[] { "Day 1: AI Fundamentals & Setup", "Day 2: Chat Completions", "Day 3: Streaming", "Day 4: System Prompts", "Day 5: Chat History", "Day 6: Model Parameters", "Day 7: Tokenization" }) },
        { 2, ("Gateway", "bg-secondary", "text-secondary", "bg-secondary", new[] { "Day 1: Reverse Proxy basics", "Day 2: Route Routing rules", "Day 3: Request Rate Limiting" }) },
        { 3, ("RAG", "bg-success", "text-success", "bg-success", new[] { "Day 1: Vector Embeddings", "Day 2: Chunking Strategies", "Day 3: Vector Storage Hub" }) },
        { 4, ("Tools", "bg-info text-dark", "text-info", "bg-info", new[] { "Day 1: Function Calling Basics", "Day 2: Tool Definitions API" }) },
        { 5, ("Kernel", "bg-warning text-dark", "text-warning", "bg-warning", new[] { "Day 1: Semantic Kernel Intro", "Day 2: Native Plugins" }) },
        { 6, ("Agents", "bg-danger", "text-danger", "bg-danger", new[] { "Day 1: Agentic Orchestration", "Day 2: Multi-Agent Teams" }) },
        { 7, ("MCP", "bg-dark", "text-dark", "bg-dark", new[] { "Day 1: Protocol Standards", "Day 2: Custom Client Servers" }) },
        { 8, ("Azure", "bg-primary", "text-primary", "bg-primary", new[] { "Day 1: Azure OpenAI Deployment", "Day 2: App Service Hosting" }) }
    };
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Learn AI Curriculum</h1>
        <p class="lead text-muted">Master production-ready AI development week by week.</p>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 p-4 bg-light text-center">
                <h3 class="h6 fw-bold text-secondary text-uppercase mb-2">Overall Course Completion</h3>
                <div class="progress mb-2" style="height: 20px;">
                    <div id="totalCourseProgressBar" class="progress-bar bg-success progress-bar-striped progress-bar-animated fw-bold" role="progressbar" style="width: 0%">0%</div>
                </div>
                <p class="text-muted small mb-0">Tracked dynamically across all 8 specialized modules.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var kvp in modules)
        {
            int weekId = kvp.Key;
            var mod = kvp.Value;

            <div class="col-12 col-md-6 col-lg-4">
                <a href="@Url.Action("LoadWeek", "Course", new { id = weekId })" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm border-0 transition-tile position-relative overflow-hidden">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge @mod.BadgeClass">Week @weekId</span>
                                    <span id="badge-status-W@weekId" class="badge bg-light text-success border border-success d-none">Done</span>
                                </div>
                                <h3 class="h4 card-title fw-bold text-dark mt-1 mb-3">@mod.Title</h3>

                                <ul class="list-unstyled border-top pt-3 mb-0">
                                    @foreach (var dayLabel in mod.Days)
                                    {
                                        <li class="small text-secondary mb-2 d-flex align-items-center gap-2">
                                            <span class="text-muted text-opacity-50">•</span> @dayLabel
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="mt-4 border-top pt-3">
                                <div class="progress mb-2" style="height: 6px; background-color: #e9ecef;">
                                    <div id="tileProgressBar-W@weekId" class="progress-bar @mod.BarClass" role="progressbar" style="width: 0%"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted" id="progress-text-W@weekId">0% ready</span>
                                    <span class="@mod.TextClass fw-semibold small">Explore Module &rarr;</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<script>
    window.trueWeekItemTotals = @Html.Raw(ViewBag.TotalCounts ?? "{}");
</script>
