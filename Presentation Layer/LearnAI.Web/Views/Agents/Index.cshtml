@model LearnAI.Agents.Models.AgentState

@{
    ViewData["Title"] = "Agent Workspace";
}

<div class="container-fluid py-4">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="post" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="goal" class="form-control form-control-lg" placeholder="Enter a complex goal (e.g., Write a compliance report on solar data)..." value="@Model.UserGoal" />
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey("goal"))
                    {
                        <div class="text-danger small mt-1">@ViewData.ModelState["goal"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
                    }
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Run Agent</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.ExecutionPlan?.Tasks != null && Model.ExecutionPlan.Tasks.Any())
    {
        <div class="row">
            <div class="col-lg-5 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Strategic Execution Roadmap</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            @foreach (var task in Model.ExecutionPlan.Tasks)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start @(task.IsCompleted ? "list-group-item-success" : "")">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">@task.TargetAgent</div>
                                        <small class="text-muted">@task.Description</small>
                                        @if (!string.IsNullOrEmpty(task.OutputSummary))
                                        {
                                            <div class="mt-2 small text-dark p-2 bg-light border rounded font-monospace">@task.OutputSummary</div>
                                        }
                                    </div>
                                    <span class="badge @(task.IsCompleted ? "bg-success" : "bg-secondary") rounded-pill">
                                        @(task.IsCompleted ? "Done" : "Pending")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Execution Traces & Reasoning Monologue</h5>
                    </div>
                    <div class="card-body bg-light text-dark font-monospace" style="max-height: 500px; overflow-y: auto;">
                        @foreach (var step in Model.Steps)
                        {
                            <div class="mb-3 border-bottom pb-2">
                                <div class="text-muted small">[@step.Timestamp.ToString("HH:mm:ss")] Step ID: @step.Id</div>
                                <div class="text-primary fw-bold mt-1">🤔 Thought:</div>
                                <div class="ps-3 mb-2 text-secondary">@step.Thought</div>
                                <div class="text-danger fw-bold">🚀 Action:</div>
                                <div class="ps-3 mb-2 text-dark"><strong>@step.Action</strong></div>
                                <div class="text-success fw-bold">👁️ Observation:</div>
                                <div class="ps-3 text-success">@step.Observation</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsComplete)
        {
            <div class="card shadow-sm border-success mt-2">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🏁 Final Answer Output Artifact</h5>
                </div>
                <div class="card-body bg-white text-dark">
                    <p class="lead" style="white-space: pre-line;">@Model.FinalAnswer</p>
                </div>
            </div>
        }
    }
</div>